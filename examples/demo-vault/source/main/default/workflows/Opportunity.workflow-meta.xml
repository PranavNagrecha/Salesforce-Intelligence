<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Flag_As_High_Value</fullName>
        <description>Stamp the opportunity description when it crosses the high-value threshold.</description>
        <field>Description</field>
        <name>Flag As High Value</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <formula>"HIGH VALUE - " &amp; TEXT(Amount)</formula>
    </fieldUpdates>
    <rules>
        <fullName>High_Value_Flag</fullName>
        <actions>
            <name>Flag_As_High_Value</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Flag opportunities over 100,000 for executive review (legacy workflow rule, kept for order-of-execution demo).</description>
        <formula>Amount &gt; 100000</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
