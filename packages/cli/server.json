{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.PranavNagrecha/sf-intelligence",
  "description": "Offline, read-only MCP knowledge base for one Salesforce org's metadata, deps & impact.",
  "status": "active",
  "repository": {
    "url": "https://github.com/PranavNagrecha/Salesforce-Intelligence",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sf-intelligence",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "subcommand",
          "isRequired": true,
          "description": "Run the MCP server backing the local org-kb vault."
        }
      ]
    }
  ]
}
