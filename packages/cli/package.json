{
  "name": "sf-intelligence",
  "version": "0.3.1",
  "description": "Salesforce Org Intelligence for AI agents: a read-only, offline, source-available MCP server and CLI. Ask about your org's metadata, dependencies, permissions, Apex and Flows \u2014 grounded in real retrieved metadata. Ships the sfi CLI and an MCP server.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://sfi.auditforce.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PranavNagrecha/Salesforce-Intelligence.git"
  },
  "bugs": {
    "url": "https://github.com/PranavNagrecha/Salesforce-Intelligence/issues"
  },
  "mcpName": "io.github.PranavNagrecha/sf-intelligence",
  "keywords": [
    "salesforce",
    "salesforce-metadata",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "cursor",
    "cline",
    "ai-agent",
    "llm",
    "cli",
    "metadata",
    "knowledge-base",
    "offline",
    "sfdx",
    "apex",
    "salesforce-cli",
    "agent-skills",
    "agentforce",
    "dependency-analysis",
    "impact-analysis",
    "read-only",
    "flow",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "sfi": "./bin/sfi.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/apex-ast-worker.js",
    "bin",
    "README.md",
    "server.json",
    "demo-source"
  ],
  "scripts": {
    "build": "tsc --build && node build.mjs",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "5.0.0",
    "@duckdb/node-api": "1.5.3-r.2",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "fast-xml-parser": "^4.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@sf-intelligence/contracts": "workspace:*",
    "@sf-intelligence/core": "workspace:*",
    "@sf-intelligence/extractors": "workspace:*",
    "@sf-intelligence/graph": "workspace:*",
    "@sf-intelligence/mcp": "workspace:*",
    "@sf-intelligence/parsers": "workspace:*",
    "@sf-intelligence/patterns": "workspace:*",
    "@sf-intelligence/renderers": "workspace:*",
    "@sf-intelligence/tooling-api": "workspace:*",
    "@sf-intelligence/vault": "workspace:*",
    "esbuild": "^0.28.0",
    "vitest": "^3.2.4"
  }
}
