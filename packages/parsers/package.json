    },
    "./apex-ast": {
      "types": "./dist/src/apex-ast-edges.d.ts",
      "import": "./dist/src/apex-ast-edges.js"
    },
    "./apex-ast-spike": {
      "types": "./dist/src/apex-ast-spike.d.ts",
