{
  "name": "@sf-intelligence/parsers",
  "version": "0.1.0",
  "private": true,
  "description": "Source parsers (Apex scanner, formula tokenizer, frontend scanner).",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PranavNagrecha/Salesforce-Intelligence.git",
    "directory": "packages/parsers"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
