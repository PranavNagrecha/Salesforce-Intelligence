    },
    "./soql-selectivity": {
      "types": "./dist/src/soql-selectivity.d.ts",
      "import": "./dist/src/soql-selectivity.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "5.0.0",
    "@sf-intelligence/contracts": "workspace:*",
