---
import Base from "../layouts/Base.astro";

const title = "Page not found · sf-intelligence";
const description = "That page could not be found. Head back to the sf-intelligence home page, the demo, or the setup guide.";
---

<Base title={title} description={description} path="/404" index={false}>
  <section class="page-hero" style="border-bottom:0">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>We couldn’t find that page.</h1>
      <p class="lede">Nothing lives at <code id="path">this address</code>. It may have moved, or the link may be mistyped.</p>
      <div class="btns" style="margin-top:28px">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-secondary" href="/demo">See the demo</a>
        <a class="btn btn-secondary" href="/getting-started">Getting started</a>
      </div>
    </div>
  </section>
</Base>
