---
import Base from "../layouts/Base.astro";
import site from "../data/site.ts";

const title = "404 - command not found · sf-intelligence";
const description = "That page could not be found. Head back to the sf-intelligence overview.";
---

<Base title={title} description={description} path="/404" index={false}>
  <section style="min-height:64vh; display:grid; place-items:center;">
    <div class="container" style="max-width:680px;">
      <div class="screen">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="ttl">sh - error</span></div>
        <div class="scr">
          <p class="line"><span class="u">cd <span class="warn" id="path">that-page</span></span></p>
          <p class="line"><span class="out">sh: no such file or directory</span></p>
          <p class="line"><span class="warn">▸ exit code 404</span></p>
          <p class="line"><span class="sys"># the page you wanted doesn't exist - or it moved.</span></p>
          <p class="line">&nbsp;</p>
          <p class="line"><span class="u">ls /</span></p>
          <p class="line">
            <span class="opt"><a href="/">overview</a></span>
            <span class="opt"><a href="/capabilities">capabilities</a></span>
            <span class="opt"><a href="/getting-started">getting-started</a></span>
            <span class="opt"><a href="/faq">faq</a></span>
            <span class="opt"><a href={site.github} rel="noopener">GitHub</a></span>
          </p>
          <p class="line"><span class="u"><span class="cursor" aria-hidden="true"></span></span></p>
        </div>
      </div>
      <h1 class="screen-type center" style="font-size:clamp(3rem,12vw,6rem); color:var(--green); text-shadow:var(--glow-strong); margin:28px 0 18px;">404</h1>
      <div class="cta-actions" style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a class="btn btn-solid" href="/">back to overview</a>
        <a class="btn btn-ghost" href="/capabilities">capabilities</a>
      </div>
    </div>
  </section>
</Base>
