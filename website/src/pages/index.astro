---
import Base from "../layouts/Base.astro";
import CmdText from "../components/CmdText.astro";
import AnswerTabs from "../components/AnswerTabs.astro";
import ChatPanel from "../components/ChatPanel.astro";
import FaqBlock from "../components/FaqBlock.astro";
import InstallTabs from "../components/InstallTabs.astro";
import TryDemo from "../components/TryDemo.astro";
import { deleteField, homeAnswers } from "../data/demo-answers.ts";
import { DEMO_CLAUDE_CODE } from "../data/install.ts";
import site from "../data/site.ts";
import siteData from "../data/site-data.json";
import guidesData from "../data/guides.json";

const version = siteData.version;
const ORG_ID = `${site.url}/#org`;

const title = "sf-intelligence: Free Offline Salesforce MCP Server";
const description =
  "Ask Claude, Cursor or VS Code what breaks before you change Salesforce. Free, read-only, runs on your computer, and every answer names the components it used.";

const jsonld = [
  {
    "@type": "SoftwareApplication",
    "@id": `${site.url}/#software`,
    name: "sf-intelligence",
    alternateName: site.alternateName,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Salesforce MCP server",
    operatingSystem: "macOS, Linux, Windows (Node.js 20+)",
    softwareVersion: version,
    description:
      "A free, read-only Salesforce MCP server. It reads one org's metadata into a folder on your computer and answers impact, access and automation questions in your AI assistant, naming every component each answer relies on.",
    license: `${site.url}/licensing`,
    url: `${site.url}/`,
    downloadUrl: site.npm,
    codeRepository: site.github,
    softwareHelp: `${site.url}/getting-started`,
    author: { "@id": ORG_ID },
    publisher: { "@id": ORG_ID },
    sameAs: site.sameAs,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: [
      "Can I delete this field? Every dependent named, plus what was and wasn't checked",
      "Who can edit this object? Profiles and permission sets, with what each grants",
      "What runs when a record is saved? The automation in Salesforce's save order",
      "What sets this field to this value? Automation that does, might, or can't",
      "Is this deployment risky? Go, review first, or no-go, with reasons",
      "A one-page brief of any object for someone new to the org",
      "Read-only: never writes to the org",
      "Runs offline from a local metadata snapshot",
    ],
  },
];

const newIn = [
  { tag: "Deployments", q: "“Is this deployment risky?”", text: "Get a go, review first, or no-go, with the reasons behind it.", href: "/demo#demo-deployment-risk" },
  { tag: "Fields", q: "“What sets this field to this value?”", text: "See the automation that can put a specific value into a field.", href: "/demo#demo-sets-value" },
  { tag: "Flows", q: "“Why does my flow run twice?”", text: "Find save loops, where one update sets your automation off again.", href: "/demo#demo-save-order" },
  { tag: "Onboarding", q: "“Brief me on this object.”", text: "A one-page brief of any object, written for someone new to the org.", href: "/demo#demo-object-brief" },
];

// Guides block: the cards marked "home" in src/data/guides.json, in file order.
const guides = guidesData.guides.filter((g) => g.home);

const faqs = [
  { q: "Is it free?", a: `Yes. It’s free to use, with no account or sign-up. See <a href="/licensing">Licensing</a> for the terms.` },
  { q: "Does it change my org?", a: "No. It only reads your org’s metadata. It never deploys, edits records, or changes settings." },
  {
    q: "Do I need a Salesforce login to try it?",
    a: `No. The demo org is built in: add it to your assistant with one command (for Claude Code, <code>${DEMO_CLAUDE_CODE}</code>) and start asking. You only sign in when you connect your own org.`,
  },
  {
    q: "Which AI assistants work?",
    a: `Claude Code, Claude Desktop, Cursor, VS Code with GitHub Copilot, and Codex. Setup for each is in the <a href="#install">Install</a> section.`,
  },
  {
    q: "Does my org’s metadata leave my computer?",
    a: `No. The snapshot is a folder on your computer and is never uploaded, and sf-intelligence sends no telemetry unless you opt in. Your AI assistant sees the answers it asks for, the same as anything else you share with it. More on <a href="/trust">Trust &amp; security</a>.`,
  },
];
---

<Base title={title} description={description} path="/" jsonld={jsonld}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Free for Salesforce admins, developers and architects</span>
        <h1 id="hero-title">Know what breaks before you change Salesforce.</h1>
        <p class="lede">Ask the AI assistant you already use about your org. sf-intelligence runs on your computer, never writes to your org, and every answer names the components it relied on.</p>

        <TryDemo />

        <div class="hero-links">
          <a class="btn btn-secondary" href="#answers">See a real answer</a>
          <a class="text-link" href="#install">Connect your own org <span aria-hidden="true">&rarr;</span></a>
        </div>

        <p class="works-in">Works in <strong>Claude Code</strong> <span class="sep" aria-hidden="true">·</span> <strong>Claude Desktop</strong> <span class="sep" aria-hidden="true">·</span> <strong>Cursor</strong> <span class="sep" aria-hidden="true">·</span> <strong>VS Code + Copilot</strong> <span class="sep" aria-hidden="true">·</span> <strong>Codex</strong></p>
      </div>

      <ChatPanel answer={deleteField} href="/demo#demo-delete-field" />
    </div>
  </section>

  <!-- Real answers -->
  <section class="section band" id="answers" aria-labelledby="answers-title">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Real answers</span>
        <h2 id="answers-title">Straight answers, with the receipts.</h2>
        <p>Three questions asked of the built-in demo org, Verdant, a solar-installation company. Every component in an answer is named, so you can check it yourself.</p>
      </div>
      <AnswerTabs answers={homeAnswers} idPrefix="home" showTool={false} showIds={false} />
      <p class="more"><a class="text-link" href="/demo">See all the demo answers, including the tool calls <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <!-- What's new -->
  <section class="section" id="new" aria-labelledby="new-title">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">New in {version}</span>
        <h2 id="new-title">Four new questions you can ask.</h2>
      </div>
      <div class="card-grid">
        {newIn.map((n) => (
          <article class="new-card">
            <span class="pill pill-neutral">{n.tag}</span>
            <h3>{n.q}</h3>
            <p>{n.text}</p>
            <a class="text-link" href={n.href}>See it on the demo org <span aria-hidden="true">&rarr;</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section band" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">How it works</span>
        <h2 id="how-title">Three steps.</h2>
      </div>
      <ol class="how">
        <li>
          <span class="n">Step 1</span>
          <h3>Install</h3>
          <p>Add sf-intelligence to your AI assistant with one command or a short config entry.</p>
        </li>
        <li>
          <span class="n">Step 2</span>
          <h3>Read your org once</h3>
          <p>It reads your org’s metadata, read-only, into a folder on your computer. Run it again whenever your org changes.</p>
          <code class="inline-cmd" tabindex="0"><CmdText cmd="npx -y sf-intelligence init --target-org my-org" /></code>
          <code class="inline-cmd" tabindex="0"><CmdText cmd="npx -y sf-intelligence refresh" /></code>
        </li>
        <li>
          <span class="n">Step 3</span>
          <h3>Ask in your AI assistant</h3>
          <p>Ask in plain words, the way you would ask a colleague. Answers name the fields, flows, classes and permissions they relied on.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Safe for production -->
  <section class="section" id="safe" aria-labelledby="safe-title">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Safe for production</span>
        <h2 id="safe-title">Built so you can point it at the real org.</h2>
      </div>
      <div class="safe-grid">
        <div class="safe-item">
          <div class="safe-icon" aria-hidden="true">
            <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="14" height="9" rx="2"></rect><path d="M7.5 10V7a3.5 3.5 0 0 1 7 0v3"></path></svg>
          </div>
          <h3>Read-only</h3>
          <p>It never writes to your org. No deploys, no data changes, no settings touched.</p>
        </div>
        <div class="safe-item">
          <div class="safe-icon" aria-hidden="true">
            <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="16" height="10" rx="1.5"></rect><path d="M1.5 17.5h19"></path></svg>
          </div>
          <h3>Offline</h3>
          <p>Your metadata stays on your machine. After the first read, it works without a connection to Salesforce.</p>
        </div>
        <div class="safe-item">
          <div class="safe-icon" aria-hidden="true">
            <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5h12v9H9l-4 3.5V5Z"></path><path d="m8.5 9.5 1.8 1.8 3.4-3.6"></path></svg>
          </div>
          <h3>Cited</h3>
          <p>Every answer names the components it used. When it hasn’t checked something, it says “not checked” instead of guessing.</p>
        </div>
      </div>
      <p class="more"><a class="text-link" href="/trust">How it’s tested, and what it can’t see <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <!-- Install -->
  <section class="section band" id="install" aria-labelledby="install-title">
    <div class="wrap install-grid">
      <div class="install-aside">
        <span class="kicker">Install</span>
        <h2 id="install-title">Add it to your assistant.</h2>
        <p>Pick your assistant, copy the snippet, and restart it.</p>
        <ol>
          <li>Run <code>init</code> and <code>refresh</code> once to read your org into an <code>org-kb</code> folder.</li>
          <li>Add the snippet for your assistant, with the full path to that folder.</li>
          <li>Ask a question about your org.</li>
        </ol>
        <a class="text-link" href="/getting-started">Full setup guide <span aria-hidden="true">&rarr;</span></a>
      </div>
      <InstallTabs mode="org" idPrefix="home-host" />
    </div>
  </section>

  <!-- Guides -->
  <section class="section" id="guides" aria-labelledby="guides-title">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Guides</span>
        <h2 id="guides-title">Plain-English guides for common Salesforce jobs.</h2>
      </div>
      <div class="card-grid">
        {guides.map((g) => (
          <article class="new-card">
            <h3><a href={g.href}>{g.title}</a></h3>
            <p>{g.text}</p>
          </article>
        ))}
      </div>
      <p class="more"><a class="text-link" href="/blog">All guides <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section band" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Questions</span>
        <h2 id="faq-title">Common questions.</h2>
      </div>
      <FaqBlock faqs={faqs} />

      <div class="closing">
        <h2>Try it on the demo org first.</h2>
        <div class="btns">
          <button class="btn btn-primary copy-btn" type="button" data-copy={DEMO_CLAUDE_CODE}>Copy demo command</button>
          <a class="btn btn-secondary" href="/getting-started">Install</a>
        </div>
      </div>
    </div>
  </section>
</Base>
