---
import InfoPage from "../layouts/InfoPage.astro";
import FaqBlock from "../components/FaqBlock.astro";
import site from "../data/site.ts";

/* Every term on this page is quoted from, or a plain reading of, the LICENSE
 * file at the repository root. Do not add terms that file doesn't contain. */
const title = "sf-intelligence License: What You Can Do";
const description =
  "sf-intelligence is open source under the MIT license. Use it at work, on client orgs, in products and services. The terms, quoted.";
const licenseUrl = `${site.github}/blob/main/LICENSE`;

const faqs = [
  {
    q: "Is it free to use at work?",
    a: "Yes. Using it inside a company, on your company’s orgs, costs nothing and needs no licence beyond the one it ships with.",
  },
  {
    q: "Is it open source?",
    a: "Yes. It is licensed under the MIT license, which the Open Source Initiative recognises. Releases before 0.5.0 carried an extra Commons Clause condition; from 0.5.0 on that condition is gone.",
  },
  {
    q: "Can I change it and share my changes?",
    a: "Yes. The MIT grant covers modifying, merging, publishing, distributing and selling copies, as long as the copyright notice and the permission notice go with them.",
  },
  {
    q: "Can I build a paid product or service on it?",
    a: "Yes. MIT places no restriction on commercial use. The only obligation is to keep the licence notice with the software.",
  },
  {
    q: "Do I have to credit sf-intelligence?",
    a: "Beyond keeping the licence notice in copies of the software, no. Attribution is appreciated but not required.",
  },
  {
    q: "Is there a warranty?",
    a: "No. Like any MIT-licensed software it’s provided “as is”, without warranty of any kind.",
  },
];
---

<InfoPage
  title={title}
  description={description}
  path="/licensing"
  heading="What the licence lets you do"
  lede="Open source under MIT. Free to use, change, share and sell, at work, on client orgs, or inside your own product."
  crumbs={[{ name: "Licensing", path: "/licensing" }]}
  dateModified="2026-10-15"
>
  <div class="answer-first narrow">
    <span class="label">Short answer</span>
    <p>sf-intelligence is licensed under the <strong>MIT License</strong>. You can use, copy, change, share and sell it. The one condition is that the copyright notice and the permission notice stay with any copy. Releases before 0.5.0 carried a Commons Clause condition that forbade selling; 0.5.0 removed it.</p>
  </div>

  <section class="block" aria-labelledby="allowed">
    <h2 id="allowed">Allowed, no permission needed</h2>
    <div class="split">
      <div class="panel accent">
        <h3>Using it</h3>
        <ul class="ticks">
          <li>On your own or your employer’s orgs</li>
          <li>On client orgs, as a consultant</li>
          <li>Inside a paid product or hosted service</li>
          <li>For support or consulting work</li>
        </ul>
      </div>
      <div class="panel tint">
        <h3>Changing and sharing it</h3>
        <ul class="ticks">
          <li>Reading, changing and forking the code</li>
          <li>Sharing copies, with the licence notice included</li>
          <li>Selling copies or derived works</li>
          <li>Contributing changes back (see CONTRIBUTING on GitHub)</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="block narrow" aria-labelledby="terms">
    <h2 id="terms">The terms, quoted</h2>
    <blockquote class="license-quote">
      <p>Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the “Software”), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions: The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.</p>
      <cite>LICENSE, MIT License</cite>
    </blockquote>
    <p>Read the whole file on <a href={licenseUrl} rel="noopener">GitHub</a>. It also ships inside the <a href={site.npm} rel="noopener">npm package</a>.</p>
  </section>

  <section class="block" aria-labelledby="faq">
    <h2 id="faq">Questions</h2>
    <FaqBlock faqs={faqs} />
  </section>

  <nav class="block narrow" aria-labelledby="more">
    <h2 id="more">Related</h2>
    <ul class="link-list">
      <li><a href="/use-cases/consultants">Learn a client’s org in an afternoon</a><span> · for consultants</span></li>
      <li><a href="/trust">How it keeps your org safe</a></li>
      <li><a href="/faq">FAQ</a></li>
    </ul>
  </nav>
</InfoPage>
