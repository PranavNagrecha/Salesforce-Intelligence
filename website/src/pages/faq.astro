---
import InfoPage from "../layouts/InfoPage.astro";
import CtaBlock from "../components/CtaBlock.astro";
import FaqBlock, { type Faq } from "../components/FaqBlock.astro";

const title = "sf-intelligence FAQ: Safety, Setup and Licensing";
const description =
  "Plain answers to what Salesforce admins ask first: does it change my org, where does my data go, what it costs, what it needs, and how far to trust the answers.";

const groups: { id: string; label: string; faqs: Faq[] }[] = [
  {
    id: "safety",
    label: "Safety and privacy",
    faqs: [
      {
        q: "Does it write to or change my Salesforce org?",
        a: "No. It has no way to write. The refresh only retrieves metadata, and no tool deploys, edits or deletes anything. More on <a href=\"/trust\">Trust</a>.",
      },
      {
        q: "Does my org’s data go to the cloud?",
        a: "Not through sf-intelligence. It keeps a copy of your org’s setup in a folder on your computer and answers from there. It talks to Salesforce only when you refresh, or if you turn on the optional live mode. Your AI assistant sees the answers it asks for, so use an assistant your company allows.",
      },
      {
        q: "Does it read customer records?",
        a: "Not by default. The snapshot holds setup (objects, fields, automation, code, permissions), not records. The optional live mode can read capped counts and samples, read-only, once you turn it on for that org.",
      },
      {
        q: "Is it safe to use on production?",
        a: "Yes, that’s what it’s built for. It reads once, writes never, and nothing is installed in the org.",
      },
    ],
  },
  {
    id: "answers",
    label: "The answers",
    faqs: [
      {
        q: "How is this different from asking Claude or ChatGPT on its own?",
        a: "On its own, an AI answers from general Salesforce knowledge, which is often wrong about your org. With sf-intelligence it answers from your org’s actual setup, names each component it relies on, and asks which one you mean when a name matches more than one thing.",
      },
      {
        q: "Are the answers always right?",
        a: "Each one shows how sure it is. Connections Salesforce states directly, or that come from parsing code, are reliable. Ones found by text search are marked so you can spot-check them. Apex that builds queries at run time can’t be read statically, so “no references found” means no evidence, not “definitely unused”.",
      },
      {
        q: "Can it tell me how many records an object has?",
        a: "Only with the live mode on. The snapshot doesn’t hold records.",
      },
      {
        q: "How do I keep answers current?",
        a: "Refresh after changes are deployed to the org. It tells you when the snapshot is stale.",
      },
    ],
  },
  {
    id: "setup",
    label: "Setup",
    faqs: [
      {
        q: "Which AI assistants does it work with?",
        a: "Claude Code, Claude Desktop, Cursor, VS Code with Copilot, Codex, and other MCP-compatible assistants. <a href=\"/getting-started\">Setup for each</a>.",
      },
      {
        q: "What do I need to install?",
        a: "Node.js 20 or newer. To connect your own org you also need the Salesforce CLI, logged in to that org. The demo org needs neither a Salesforce login nor the CLI.",
      },
      {
        q: "Can I try it without connecting an org?",
        a: "Yes. One command adds a made-up demo org called Verdant to your assistant. Or <a href=\"/demo\">read real answers from it</a> without installing anything.",
      },
    ],
  },
  {
    id: "cost",
    label: "Cost and licence",
    faqs: [
      {
        q: "How much does it cost?",
        a: "Nothing. It’s free and source available under MIT + Commons Clause.",
      },
      {
        q: "Can I use it at work, or on client orgs?",
        a: "Yes to both. You only need a commercial licence to sell sf-intelligence itself or a service built substantially on it. <a href=\"/licensing#consultants\">Details for consultants</a>.",
      },
    ],
  },
];
const toText = (html: string): string => html.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const jsonld = [
  {
    "@type": "FAQPage",
    mainEntity: groups.flatMap((g) => g.faqs).map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: toText(f.a) },
    })),
  },
];
---

<InfoPage
  title={title}
  description={description}
  path="/faq"
  heading="Questions people ask first"
  lede="Mostly from admins deciding whether to point it at a production org."
  crumbs={[{ name: "FAQ", path: "/faq" }]}
  jsonld={jsonld}
  dateModified="2026-10-10"
>
  <nav class="toc" aria-label="Topics">
    {groups.map((g) => <a href={`#${g.id}`}>{g.label}</a>)}
  </nav>

  {groups.map((g) => (
    <section class="block" aria-labelledby={g.id}>
      <h2 id={g.id}>{g.label}</h2>
      <FaqBlock faqs={g.faqs} schema={false} />
    </section>
  ))}

  <nav class="block narrow" aria-labelledby="more">
    <h2 id="more">Still have a question?</h2>
    <ul class="link-list">
      <li><a href="/getting-started">Getting started</a></li>
      <li><a href="/capabilities">Everything it can answer</a></li>
      <li><a href="/glossary">Glossary</a></li>
    </ul>
  </nav>

  <CtaBlock />
</InfoPage>
