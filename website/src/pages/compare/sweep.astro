---
import CompareLayout from "../../layouts/CompareLayout.astro";
import { whoCanEdit } from "../../data/demo-answers.ts";
import { SFI, VERIFIED } from "../../data/compare.ts";
---

<CompareLayout
  name="Sweep"
  title="sf-intelligence vs Sweep: Salesforce Metadata Tools"
  description="Sweep is a paid agentic platform for RevOps and Salesforce teams, from $2.5K a month. sf-intelligence is a free, local, read-only MCP server for org questions."
  path="/compare/sweep"
  heading="sf-intelligence vs Sweep"
  lede="Sweep sells a hosted platform of agents for documentation, permissions, monitoring and building across your business systems. sf-intelligence answers questions about one Salesforce org, for free, from your computer."
  short="Sweep is a commercial agentic platform with documentation, permission and monitoring agents, a visual workspace, and plans from $2.5K to $7K a month billed annually, with MCP on its Platform plan and above. sf-intelligence is a free MCP server that answers questions about one org from a local metadata snapshot and never writes to it. Different budgets and different jobs."
  rows={[
    { label: "What it is", sfi: SFI.what, them: "An agentic platform for business systems: documentation, permission and monitoring agents, plus a build mode on higher plans" },
    { label: "Where metadata is processed", sfi: SFI.where, them: "In Sweep’s service" },
    { label: "Writes to the org", sfi: SFI.writes, them: "Plans include a visual workspace with read and write access, and a build mode on Platform" },
    { label: "Price", sfi: SFI.price, them: "Agentic Starter $2.5K/month, Foundation $5K/month, Platform $7K/month (billed annually); Enterprise quoted" },
    { label: "Free option", sfi: "Everything is free", them: "No free tier listed" },
    { label: "MCP", sfi: "It is an MCP server", them: "Included on the Platform plan and Enterprise" },
    { label: "Scope", sfi: "One Salesforce org at a time (compare snapshots across orgs)", them: "One org on the lower plans; multi-org and cross-platform connectors on Enterprise" },
  ]}
  chooseSfi={[
    "Cited answers about your org <strong>in your own AI assistant</strong>, for free",
    "<strong>No write access</strong> and no metadata upload",
    "Impact, access and automation questions while you build or review",
  ]}
  chooseThem={[
    "A <strong>team platform</strong> with agents that document, monitor and change your systems",
    "A visual workspace for admins and operations leaders",
    "Coverage beyond Salesforce through Enterprise connectors",
    "A vendor with support and an SLA on the top plan",
  ]}
  notSfi={[
    "You want agents to build or change things for you. sf-intelligence only explains",
    "You need ongoing monitoring with alerts. It answers when asked, from the last refresh",
    "Non-technical teammates need a web app. There isn’t one",
  ]}
  example={whoCanEdit}
  sources={[{ label: "sweep.io pricing", href: "https://www.sweep.io/pricing" }]}
  verified={VERIFIED}
  faqs={[
    {
      q: "How much does Sweep cost?",
      a: "Sweep’s pricing page lists Agentic Starter at $2.5K a month, Foundation at $5K and Platform at $7K, billed annually, with Enterprise quoted. sf-intelligence is free.",
    },
    {
      q: "Does Sweep have an MCP server?",
      a: "Its pricing page lists Model Context Protocol (MCP) on the Platform plan, and Enterprise includes everything in Platform.",
    },
    {
      q: "Do they overlap?",
      a: "A little: both document an org and explain permissions. Sweep is a platform that also monitors and builds; sf-intelligence only answers questions, read-only, from your computer.",
    },
  ]}
/>
