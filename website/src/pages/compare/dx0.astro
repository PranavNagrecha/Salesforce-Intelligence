---
import CompareLayout from "../../layouts/CompareLayout.astro";
import { saveOrder } from "../../data/demo-answers.ts";
import { SFI, VERIFIED } from "../../data/compare.ts";
---

<CompareLayout
  name="dx0"
  title="sf-intelligence vs dx0: Salesforce Org Intelligence"
  description="dx0 is a hosted, per-seat tool for understanding inherited business systems, from €85 a user a month. sf-intelligence is free, local and read-only."
  path="/compare/dx0"
  heading="sf-intelligence vs dx0"
  lede="dx0 is a polished hosted product for understanding business systems you inherited, Salesforce and NetSuite included. sf-intelligence is a free MCP server you run yourself. The choice comes down to where your metadata may go, who needs the answers, and budget."
  short="dx0 is a hosted product, ISO 27001 certified, priced from €85 per user a month (Team) or €110 (Business), with a 7-day trial that starts with a demo, and MCP search from Claude or Cursor. sf-intelligence is free, keeps the metadata on your computer, and answers in your AI assistant with each component named. Pick dx0 for a shared tool with the paperwork done; pick sf-intelligence when metadata can’t leave your machine or budget is zero."
  rows={[
    { label: "What it is", sfi: SFI.what, them: "Hosted “business systems intelligence” for Salesforce, NetSuite, integrations and more" },
    { label: "Where metadata is processed", sfi: SFI.where, them: "In dx0’s service" },
    { label: "Price", sfi: SFI.price, them: "Team €85 and Business €110 per user per month, from 2 users; 10% off yearly" },
    { label: "Trial", sfi: "Free to use; demo org with one command", them: "7-day free trial, starting with a demo call" },
    { label: "Security paperwork", sfi: "Read the source; you are the auditor", them: "ISO 27001 certified and independently audited, per their site" },
    { label: "MCP", sfi: "It is an MCP server", them: "MCP search from inside Claude or Cursor on both plans" },
    { label: "Interface", sfi: "Your AI assistant. No web app", them: "Web app, plus Claude and Cursor" },
    { label: "Source code", sfi: SFI.source, them: "Closed" },
  ]}
  chooseSfi={[
    "Org metadata that <strong>never leaves your computer</strong>",
    "Answers <strong>inside the assistant</strong> you already use, with each component named",
    "No per-seat cost across a large team",
    "No way for the tool to write to the org",
  ]}
  chooseThem={[
    "A <strong>hosted tool non-developers will open</strong>, with nothing to install or refresh",
    "Certification and a vendor security pack for procurement",
    "One place for Salesforce, NetSuite and the systems around them",
    "Someone accountable for support and uptime",
  ]}
  notSfi={[
    "The people who need answers won’t use an AI assistant or a terminal",
    "You need a snapshot that stays current without anyone running a refresh",
    "You need systems other than Salesforce covered",
  ]}
  example={saveOrder}
  sources={[
    { label: "dx0.io home page", href: "https://dx0.io" },
    { label: "dx0.io pricing", href: "https://dx0.io/pricing2" },
  ]}
  verified={VERIFIED}
  faqs={[
    {
      q: "Is dx0 less secure because it’s hosted?",
      a: "No, and it would be unfair to suggest it. dx0 says it is ISO 27001 certified and independently audited. The real question is whether your org’s metadata may be processed by a third party at all. If it may not, a local tool is the only option.",
    },
    {
      q: "Does dx0 work with Claude?",
      a: "Yes. Both of its plans include MCP search from inside Claude or Cursor. An earlier version of this page said dx0 didn’t mention MCP; that is out of date.",
    },
    {
      q: "How much does dx0 cost?",
      a: "Its pricing page lists Team at €85 and Business at €110 per user per month, billed monthly from 2 users, with 10% off yearly. sf-intelligence is free.",
    },
  ]}
/>
