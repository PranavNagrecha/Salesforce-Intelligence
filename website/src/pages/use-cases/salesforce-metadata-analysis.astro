---
import UseCaseLayout from "../../layouts/UseCaseLayout.astro";
import { objectBrief } from "../../data/demo-answers.ts";
import { orgTour } from "../../data/page-answers.ts";
---

<UseCaseLayout
  title="Salesforce Metadata Analysis in Plain Language"
  description="Ask about your Salesforce org's objects, fields, flows, Apex, permissions and integrations in plain words, and get answers from its real metadata."
  path="/use-cases/salesforce-metadata-analysis"
  heading="Understand an org you didn’t build"
  lede="Find out what’s in a Salesforce org, what each object is for, and how the pieces connect, by asking. Answers come from the org’s own metadata, not from what Salesforce orgs usually look like."
  crumb="Metadata analysis"
  audience="new admins, developers and consultants"
  short="Ask your AI assistant “give me a tour of this org” or “brief me on the Invoice object”. sf-intelligence reads a snapshot of the org’s metadata (objects, fields, flows, Apex, permissions, integrations) and answers from it, naming each component. If a name is misspelled or matches several things, it asks which one you mean."
  answers={[orgTour, objectBrief]}
  answerIntro="Two orientation questions asked of Verdant, the demo org: the whole org first, then one object."
  asks={[
    "Give me a tour of this org.",
    "Brief me on the Invoice object.",
    "What fields does Project have, and which are required?",
    "Is there already a field for customer health?",
    "What external systems does this org talk to?",
    "Generate a data dictionary for Invoice.",
  ]}
  checks={[
    "<strong>Objects and fields</strong>, including record types, picklist values and relationships",
    "<strong>Automation</strong>: flows, workflow, approval processes and assignment rules",
    "<strong>Code</strong>: Apex classes and triggers, Lightning components and Visualforce",
    "<strong>Access</strong>: profiles, permission sets, sharing rules and roles",
    "<strong>Integrations</strong>: named credentials, endpoints and platform events, plus OmniStudio",
  ]}
  limits={[
    "Business records. It reads setup, not data, unless you turn on the optional live mode",
    "Kinds of metadata your refresh didn’t pull. Answers name them",
    "What people meant a field for, beyond its description and help text",
  ]}
  tools={["org_card", "org_overview", "object_360", "list_components", "search_components", "resolve", "generate_data_dictionary", "integration_map"]}
  related={[
    { href: "/blog/salesforce-data-dictionary", label: "How to create a Salesforce data dictionary", note: "guide" },
    { href: "/use-cases/consultants", label: "For consultants", note: "org discovery on client orgs" },
    { href: "/use-cases/salesforce-dependency-analysis", label: "Dependency analysis", note: "use case" },
    { href: "/demo#demo-object-brief", label: "The full Invoice brief", note: "demo" },
  ]}
  faqs={[
    {
      q: "What if I don’t know the exact API name?",
      a: "Ask with the words you have, typos included. It matches names loosely, and when several components could fit it asks which one you mean instead of picking one.",
    },
    {
      q: "Can it write documentation for me?",
      a: "Yes. It can produce a one-page brief of an object, a data dictionary, an admin handbook, an architecture overview or an onboarding doc, each dated with the snapshot it came from.",
    },
    {
      q: "How current are the answers?",
      a: "As current as your last refresh. Run a refresh after the org changes; the health check tells you when the snapshot is out of date.",
    },
  ]}
  cta={{ question: objectBrief.question, related: { href: "/use-cases/consultants", label: "Org discovery for consultants" } }}
  dateModified="2026-10-10"
>
  <h2>Why not paste the metadata into a chatbot?</h2>
  <p>A real org has thousands of components, far more than fits in a chat. A general assistant fills the gaps with what orgs usually look like, which is how you get confident answers about fields that don’t exist. sf-intelligence keeps the whole snapshot on your computer and hands your assistant only the facts a question needs, each one named so you can check it.</p>
</UseCaseLayout>
