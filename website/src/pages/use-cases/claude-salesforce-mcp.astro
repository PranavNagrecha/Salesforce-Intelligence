---
import UseCaseLayout from "../../layouts/UseCaseLayout.astro";
import InstallTabs from "../../components/InstallTabs.astro";
import { deleteField } from "../../data/demo-answers.ts";
---

<UseCaseLayout
  title="Claude Salesforce MCP: Ask Claude About Your Org"
  description="Connect Claude Code, Claude Desktop, Cursor, VS Code or Codex to your Salesforce org's metadata with a free, read-only MCP server that runs on your computer."
  path="/use-cases/claude-salesforce-mcp"
  heading="Ask Claude about your Salesforce org"
  lede="Claude knows Salesforce in general. It doesn’t know your org. Add sf-intelligence and Claude answers from your org’s real metadata, naming every component it relied on."
  crumb="Claude + Salesforce"
  audience="anyone using Claude, Cursor, VS Code or Codex with Salesforce"
  short="Add sf-intelligence to Claude as an MCP server (one command in Claude Code, a short config entry elsewhere). It reads your org’s metadata once, read-only, into a folder on your computer. Then ask Claude about fields, flows, permissions and deployments, and it answers from that snapshot with each component named."
  answers={[deleteField]}
  answerIntro="The question most people try first, asked in Claude Code against Verdant, the demo org."
  asks={[
    "Can I delete the Amount field on Invoice?",
    "What runs when a Project is saved?",
    "Who can edit Invoices?",
    "Is this deployment risky?",
    "What can I ask you about this org?",
  ]}
  checks={[
    "<strong>Works in</strong> Claude Code, Claude Desktop, Cursor, VS Code with GitHub Copilot, Codex and other MCP clients",
    "<strong>Answers from your org’s metadata</strong>, not from general Salesforce knowledge",
    "<strong>Names every component</strong> an answer relies on, so you can check it",
    "<strong>Asks which one you mean</strong> when a name matches several components",
  ]}
  limits={[
    "Changing anything in Salesforce. Pair it with a write-capable tool if you need that",
    "Business records, unless you turn on the optional read-only live mode",
    "Changes made since your last refresh",
  ]}
  tools={["capabilities", "route_question", "resolve", "safe_to_delete_field", "what_happens_on_save", "who_can_access_object"]}
  related={[
    { href: "/getting-started", label: "Getting started", note: "connect your own org in three steps" },
    { href: "/mcp", label: "What is a Salesforce MCP server?" },
    { href: "/compare/salesforce-dx-mcp", label: "sf-intelligence vs Salesforce’s MCP servers" },
    { href: "/agent-skills", label: "Agent skills and MCP tools" },
  ]}
  faqs={[
    {
      q: "Does Claude see my whole org?",
      a: "No. The metadata snapshot stays in a folder on your computer. Claude sees the answers it asks sf-intelligence for, the same as anything else you share in a chat with it.",
    },
    {
      q: "Do I need Claude Code, or does Claude Desktop work?",
      a: "Both work, as do Cursor, VS Code with Copilot, Codex and other MCP clients. Claude Code takes one command; the others take a short config entry. Use the full path to your org’s snapshot folder in every config.",
    },
    {
      q: "Can I run it next to Salesforce’s own MCP server?",
      a: "Yes. They don’t conflict. A common setup uses sf-intelligence to understand the org and a write-capable server to make changes.",
    },
  ]}
  cta={{ question: deleteField.question, related: { href: "/getting-started", label: "Full setup guide" } }}
  dateModified="2026-10-10"
>
  <h2>Try it on the demo org first</h2>
  <p>The demo org is built in, so you can see real answers before connecting anything. Pick your assistant, add the snippet, restart it, and ask a question.</p>
  <InstallTabs mode="demo" idPrefix="uc-demo" />
  <h2>Then connect your own org</h2>
  <p>Run <code>npx -y sf-intelligence init --target-org my-org</code> (your Salesforce CLI alias) and <code>npx -y sf-intelligence refresh</code> in your Salesforce project folder. That reads your org’s metadata, read-only, into an <code>org-kb</code> folder. Then point your assistant at that folder with the full path. The <a href="/getting-started">getting-started guide</a> has the snippet for each assistant.</p>
</UseCaseLayout>
