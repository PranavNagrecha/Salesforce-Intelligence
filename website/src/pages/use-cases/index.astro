---
import Base from "../../layouts/Base.astro";
import CtaBlock from "../../components/CtaBlock.astro";
import site from "../../data/site.ts";
import "../../styles/pages.css";

const title = "Salesforce Use Cases for Admins, Developers & Architects";
const description =
  "What people use sf-intelligence for: deleting fields safely, tracing dependencies, explaining flows, fixing access, reviewing deployments and learning new orgs.";

const groups = [
  {
    label: "Before you change something",
    cases: [
      { slug: "what-breaks-if-you-delete-a-field", title: "What breaks if I delete this field?", text: "Every flow, formula, roll-up and class that depends on it, plus what wasn’t checked." },
      { slug: "impact-analysis", title: "What breaks if I change this?", text: "Turning off a flow, changing a class or deploying a release: blocking, review first or go." },
      { slug: "where-is-a-field-used", title: "Where is this field used?", text: "Every component that reads, writes or shows a field, in one question." },
      { slug: "salesforce-dependency-analysis", title: "Map what depends on what", text: "Trace a field, flow or Apex class in both directions." },
    ],
  },
  {
    label: "When something is wrong",
    cases: [
      { slug: "sharing-troubleshooting", title: "Why can’t this user see it?", text: "The profile, permission or sharing rule that decides access, checked in Salesforce’s order." },
      { slug: "explain-a-salesforce-flow", title: "Explain this flow to me", text: "When a flow starts, what it changes and what happens if it fails." },
    ],
  },
  {
    label: "When the org is new to you",
    cases: [
      { slug: "salesforce-metadata-analysis", title: "Understand an org you didn’t build", text: "A tour of the org, a brief on any object, and a data dictionary." },
      { slug: "consultants", title: "Learn a client’s org in an afternoon", text: "Discovery, documentation and pre-deploy reviews for consultants." },
    ],
  },
  {
    label: "Planning for AI",
    cases: [
      { slug: "claude-salesforce-mcp", title: "Ask Claude about your org", text: "Set it up in Claude, Cursor, VS Code or Codex and ask in plain words." },
      { slug: "agent-readiness-audit", title: "Is the org ready for AI agents?", text: "Sensitive fields, agent setup, broad access and debt, before you switch an agent on." },
    ],
  },
];

const all = groups.flatMap((g) => g.cases);
const jsonld = [
  {
    "@type": "CollectionPage",
    "@id": `${site.url}/use-cases#collection`,
    name: "sf-intelligence use cases",
    description,
    isPartOf: { "@id": `${site.url}/#website` },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: all.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.title,
        url: `${site.url}/use-cases/${c.slug}`,
      })),
    },
  },
];
---

<Base title={title} description={description} path="/use-cases" breadcrumbs={[{ name: "Use cases", path: "/use-cases" }]} jsonld={jsonld}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep" aria-hidden="true">/</span><a href="/use-cases">Use cases</a>
      </nav>
      <h1>What people use it for</h1>
      <p class="lede">Each page shows the question in plain words, a real answer from the demo org, and what the tool can and can’t see. Pick the job you’re doing.</p>
    </div>
  </section>

  <div class="page-body">
    <div class="wrap">
      {groups.map((g) => (
        <section class="block" aria-label={g.label}>
          <h2>{g.label}</h2>
          <div class="card-grid">
            {g.cases.map((c) => (
              <article class="new-card">
                <h3><a href={`/use-cases/${c.slug}`}>{c.title}</a></h3>
                <p>{c.text}</p>
              </article>
            ))}
          </div>
        </section>
      ))}

      <section class="block" aria-labelledby="more">
        <h2 id="more">Still deciding?</h2>
        <ul class="link-list">
          <li><a href="/demo">See real answers on the demo org</a><span> · no install needed</span></li>
          <li><a href="/compare">Compare with other Salesforce tools</a></li>
          <li><a href="/ai-safety">Is AI safe on my Salesforce org?</a></li>
          <li><a href="/capabilities">Everything it can answer</a></li>
        </ul>
      </section>

      <CtaBlock />
    </div>
  </div>
</Base>
