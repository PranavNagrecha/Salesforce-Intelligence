---
import InfoPage from "../layouts/InfoPage.astro";
import site from "../data/site.ts";
import siteData from "../data/site-data.json";

const title = "Glossary: Salesforce MCP and Org Analysis Terms";
const description =
  "Plain definitions of the terms used on this site: MCP server, snapshot, refresh, dependency, impact analysis, confidence labels, live mode and more.";

interface Term { id: string; name: string; def: string }

/* `def` is HTML; the JSON-LD gets plain text. Counts come from site-data.json. */
const everyday: Term[] = [
  { id: "mcp-server", name: "MCP server", def: "A small program that gives an AI assistant extra tools. MCP (Model Context Protocol) is the standard Claude, Cursor, VS Code + Copilot and Codex use to call them. sf-intelligence is an MCP server that knows about one Salesforce org. <a href=\"/mcp\">More</a>." },
  { id: "snapshot", name: "Snapshot", def: "The copy of your org’s setup that sf-intelligence keeps in a folder on your computer (<code>org-kb</code>): objects, fields, automation, code, permissions and how they connect. No records. Answers come from here." },
  { id: "refresh", name: "Refresh", def: "Reading the org again, read-only, to update the snapshot. Run it after changes are deployed. Large orgs can use a staged refresh that answers the main questions within minutes." },
  { id: "metadata", name: "Metadata", def: "How the org is built, as opposed to the records in it: object and field definitions, flows, Apex, layouts, profiles, permission sets, sharing rules." },
  { id: "dependency", name: "Dependency", def: "One component relying on another. A formula that uses a field depends on that field; deleting the field breaks the formula." },
  { id: "impact-analysis", name: "Impact analysis", def: "Finding everything that depends on a component before you change or delete it. <a href=\"/use-cases/impact-analysis\">Use case</a>." },
  { id: "read-only", name: "Read-only", def: "sf-intelligence has no code that deploys, edits or deletes anything in Salesforce. Asking it to make a change gets a no and a read-only check instead. <a href=\"/trust\">Trust</a>." },
  { id: "live-mode", name: "Live mode", def: "An optional, read-only connection to the org for facts the snapshot can’t hold, such as record counts or who holds a permission set. Off until you turn it on for that org, and limited per session." },
  { id: "demo-org", name: "Demo org (Verdant)", def: "A made-up solar company’s org that ships inside sf-intelligence, so you can try it without a Salesforce login. <a href=\"/demo\">Real answers from it</a>." },
  { id: "not-checked", name: "Not checked", def: "What an answer says about a kind of metadata the refresh didn’t retrieve. It means “couldn’t look”, never “none found”." },
  { id: "static-analysis", name: "Static analysis", def: "Reading code and setup without running it. Apex that builds a query or field name at run time can’t be followed this way, so “no references” means no evidence, not “unused”." },
];

const technical: Term[] = [
  { id: "vault", name: "Vault (org-kb)", def: "The technical name for the snapshot folder: rendered component docs, a DuckDB dependency graph and manifest files. Pass its full path to the server with <code>--vault</code>." },
  { id: "component-id", name: "Canonical component ID", def: "A stable name for a component, such as <code>CustomField:Invoice__c.Amount__c</code> or <code>ApexClass:PaymentService</code>. Every component an answer names carries one." },
  { id: "edge-confidence", name: "Confidence label", def: "How a single connection was found: <strong>declared</strong> (Salesforce states it), <strong>parsed</strong> (read from code or flow XML by a parser) or <strong>heuristic</strong> (text match; spot-check it)." },
  { id: "provenance", name: "Provenance", def: "Where an answer’s facts came from: <code>offline_snapshot</code> (the snapshot), <code>live_org</code> (live mode) or <code>hybrid</code> (both, each labelled)." },
  { id: "completeness", name: "Completeness", def: "Whether every kind of metadata an answer depends on was retrieved: <code>complete</code>, <code>partial</code> or <code>unknown</code>." },
  { id: "concept-model", name: "Concept model", def: `A built-in set of ${siteData.conceptCount} general Salesforce concepts and ${siteData.conceptRuleCount} rules (master-detail cascades, junction objects, read-only roll-ups, stacked record-triggered flows and so on), with no org data in it. <code>sfi.interpret</code> matches it against your org to state what a component implies. It runs offline, without an AI model.` },
  { id: "cited-claim", name: "Cited claim", def: "One statement from <code>sfi.interpret</code>, such as “deleting this parent deletes its child records”, with the component IDs it rests on. No citation, no claim." },
  { id: "claim-confidence", name: "Claim confidence", def: "The confidence on a cited claim. It is never higher than the weakest evidence the claim rests on, and is separate from the label on a single connection." },
  { id: "applied-scope", name: "Applied scope", def: "The component a tool actually answered about, echoed back. If what you named matches nothing, or two things, the tool refuses with <code>invalid-query</code> rather than answering about the whole org." },
  { id: "core-profile", name: "Core tools", def: "The short default list of tools your assistant sees first. Everything else is reachable through <code>sfi.run_analysis</code>. <a href=\"/tools\">Tools reference</a>." },
  { id: "router", name: "Router", def: "The offline step that suggests which tools fit a plain-language question. Your assistant makes the final choice." },
];

const toText = (html: string): string => html.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const jsonld = [
  {
    "@type": "DefinedTermSet",
    "@id": `${site.url}/glossary#terms`,
    name: "sf-intelligence glossary",
    description,
    hasDefinedTerm: [...everyday, ...technical].map((t) => ({
      "@type": "DefinedTerm",
      "@id": `${site.url}/glossary#${t.id}`,
      name: t.name,
      description: toText(t.def),
    })),
  },
];
---

<InfoPage
  title={title}
  description={description}
  path="/glossary"
  heading="Glossary"
  lede="The words this site uses, in plain language. Technical terms for developers are further down."
  crumbs={[{ name: "Glossary", path: "/glossary" }]}
  jsonld={jsonld}
  dateModified="2026-10-10"
>
  <section class="block" aria-labelledby="everyday">
    <h2 id="everyday">Everyday terms</h2>
    <dl class="defs">
      {everyday.map((t) => <div id={t.id}><dt>{t.name}</dt><dd set:html={t.def} /></div>)}
    </dl>
  </section>

  <section class="block" aria-labelledby="technical">
    <h2 id="technical">Technical terms</h2>
    <p>For developers and anyone reading the raw output.</p>
    <dl class="defs">
      {technical.map((t) => <div id={t.id}><dt>{t.name}</dt><dd set:html={t.def} /></div>)}
    </dl>
  </section>

  <nav class="block narrow" aria-labelledby="more">
    <h2 id="more">Related</h2>
    <ul class="link-list">
      <li><a href="/faq#safety">FAQ: safety and privacy</a></li>
      <li><a href="/trust">How it keeps your org safe</a></li>
      <li><a href="/configuration">Configuration</a><span> · for developers</span></li>
    </ul>
  </nav>
</InfoPage>
