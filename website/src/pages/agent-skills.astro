---
import DocPage from "../layouts/DocPage.astro";
import site from "../data/site.ts";
import siteData from "../data/site-data.json";

const title = "Salesforce Agent Skills for Org Intelligence | sf-intelligence";
const description =
  "How Salesforce Agent Skills and sf-intelligence MCP tools work together: skills interpret intent, the read-only MCP layer executes grounded org reads.";

const jsonld = [
  {
    "@type": "TechArticle",
    headline: "Portable Salesforce Agent Skills, backed by grounded MCP tools",
    description:
      "How Salesforce Agent Skills and sf-intelligence read-only MCP tools divide the work: skills interpret intent and orchestrate, the MCP layer executes grounded, evidence-labelled org reads.",
    author: { "@id": `${site.url}/#org` },
    publisher: { "@id": `${site.url}/#org` },
    dateModified: "2026-07-23",
    mainEntityOfPage: `${site.url}/agent-skills`,
