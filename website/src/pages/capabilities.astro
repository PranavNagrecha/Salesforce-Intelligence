---
import InfoPage from "../layouts/InfoPage.astro";
import AnswerTabs from "../components/AnswerTabs.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { setsValue, deployRisk, objectBrief, saveOrder } from "../data/demo-answers.ts";
import site from "../data/site.ts";
import siteData from "../data/site-data.json";
import toolsData from "../data/tools.json";

const title = "What sf-intelligence Can Answer About Your Org";
const description =
  "Questions sf-intelligence answers about a Salesforce org: what breaks, what runs on save, who can see what, deployment risk, documentation and more.";

/* Each area: plain questions first, the job page, then tool names one level
 * down. Tool names link to their /tools anchors. */
const areas = [
  {
    id: "change",
    label: "Before you change something",
    text: "What depends on a field, flow, class or permission, and what would break if you deleted, renamed, deactivated or changed it.",
    asks: ["Can I delete the Amount field on Invoice?", "What breaks if I deactivate this flow?", "What if I remove the Approved value from Project Status?", "What if I make this field required?"],
    page: { href: "/use-cases/what-breaks-if-you-delete-a-field", label: "What breaks if you delete a field" },
    tools: ["safe_to_delete_field", "get_impact", "what_if_deactivate_flow", "what_if_remove_picklist_value", "what_if_make_field_required", "find_component_usages"],
  },
  {
    id: "deploy",
    label: "Before you deploy",
    text: "A go, review first or no-go on a release, from a package.xml, a git diff or a list of changes, with the tests that cover what changed.",
    asks: ["Is this deployment risky? Here’s the package.xml.", "Which tests should I run for the classes I changed?", "What’s different between the sandbox and production?"],
    page: { href: "/use-cases/impact-analysis", label: "Impact analysis before you deploy" },
    tools: ["review_change", "tests_for_change", "compare_vaults"],
  },
  {
    id: "automation",
    label: "Automation and save order",
    text: "What runs when a record is saved, in Salesforce’s order, what sets a field to a particular value, and why a flow runs twice.",
    asks: ["What runs when a Project is saved?", "What sets Invoice Status to Paid?", "Why does my flow run twice?", "What does the Project On Approve flow do?"],
    page: { href: "/use-cases/explain-a-salesforce-flow", label: "Explain a Salesforce flow" },
    tools: ["what_happens_on_save", "order_of_execution", "why_field_changed", "explain_flow", "automation_collisions"],
  },
  {
    id: "access",
    label: "Who can see and edit what",
    text: "Which profiles and permission sets grant access to an object or field, why a user can’t see a record, and which permission sets nobody holds.",
    asks: ["Who can edit Invoices?", "Why can’t Installers see Invoices?", "Who can read the Salary field?", "Which permission sets are assigned to nobody?"],
    page: { href: "/use-cases/sharing-troubleshooting", label: "Sharing and permission troubleshooting" },
    tools: ["who_can_access_object", "field_access_audit", "why_cant_user_see_record", "effective_permissions", "unassigned_permission_sets"],
  },
  {
    id: "learn",
    label: "Learn and document an org",
    text: "A tour of the org, a brief on any object for a new team member, a data dictionary, an admin handbook or an architecture overview, dated to the snapshot.",
    asks: ["Give me a tour of this org.", "Brief me on the Invoice object.", "Generate a data dictionary.", "Write an onboarding doc for a new developer."],
    page: { href: "/use-cases/salesforce-metadata-analysis", label: "Understand an org you didn’t build" },
    tools: ["org_card", "org_overview", "object_360", "generate_data_dictionary", "generate_admin_handbook", "generate_architecture_overview"],
  },
  {
    id: "code",
    label: "Code and quality",
    text: "Where a field is used in Apex and Lightning code, what a class reads and writes, likely dead code, governor-limit risks and weak tests.",
    asks: ["What does the PaymentService class read and write?", "Where is this Apex class used?", "Which methods have no real test coverage?", "Where are the governor-limit risks?"],
    page: { href: "/use-cases/salesforce-dependency-analysis", label: "Map what depends on what" },
    tools: ["find_code_usages", "call_graph", "find_dead_code", "governor_limit_risks", "test_coverage_for_method"],
  },
  {
    id: "integrations",
    label: "Integrations",
    text: "The systems the org talks to: named credentials, endpoints, outbound messages, platform events and change data capture.",
    asks: ["What external systems does this org talk to?", "List every outbound endpoint.", "Who subscribes to this platform event?"],
    page: { href: "/use-cases/salesforce-metadata-analysis", label: "Understand an org you didn’t build" },
    tools: ["integration_map", "endpoint_catalog", "outbound_message_catalog", "event_topology", "event_subscribers"],
  },
  {
    id: "health",
    label: "Health, risk and AI readiness",
    text: "Sensitive-looking fields, what AI agents can reach, technical debt, what changed between refreshes, and how fresh the snapshot is.",
    asks: ["Which fields look like they hold sensitive data?", "What can our AI agents reach?", "How much technical debt is there?", "What changed since the last refresh?"],
    page: { href: "/use-cases/agent-readiness-audit", label: "Is the org ready for AI agents?" },
    tools: ["pii_inventory", "ai_exposure_report", "tech_debt_score", "org_history", "health_check"],
  },
  {
    id: "live",
    label: "Live record facts (optional)",
    text: "Off until you turn it on for an org. Small, read-only reads: record counts, samples, field fill rates, org limits, and who holds a permission set or sits in a queue.",
    asks: ["How many Accounts have Industry filled in?", "Who holds the Sales Manager permission set?", "Who is in the Support queue?"],
    page: { href: "/trust#where", label: "How the live mode works" },
    tools: ["live_consent", "live_count", "live_field_population", "live_permset_holders", "live_group_members"],
  },
];

/* Guard: every tool named above must exist in the generated registry. */
const known = new Set(toolsData.sections.flatMap((s) => s.tools.map((t) => t.name.replace(/^sfi\./, ""))));
const unknown = areas.flatMap((a) => a.tools).filter((t) => !known.has(t));
if (unknown.length) throw new Error(`capabilities.astro names tools not in tools.json: ${unknown.join(", ")}`);

const jsonld = [
  {
    "@type": "ItemList",
    "@id": `${site.url}/capabilities#areas`,
    name: "What sf-intelligence can answer",
    itemListElement: areas.map((a, i) => ({ "@type": "ListItem", position: i + 1, name: a.label, url: `${site.url}/capabilities#${a.id}` })),
  },
];
---

<InfoPage
  title={title}
  description={description}
  path="/capabilities"
  heading="What you can ask"
  lede="Ask in plain words about your own org. Your AI assistant picks the right check, and the answer names every component it relies on and what it couldn’t check."
  crumbs={[{ name: "Capabilities", path: "/capabilities" }]}
  jsonld={jsonld}
  dateModified="2026-10-10"
>
  <section class="block" aria-labelledby="new">
    <h2 id="new">New in {siteData.version}</h2>
    <p>Four questions it now answers in one go. These are real answers from Verdant, the demo org that ships with it.</p>
    <AnswerTabs answers={[deployRisk, saveOrder, setsValue, objectBrief]} idPrefix="cap" label="New questions" level={3} />
    <p class="meta-line">Also new: a shorter default tool list, so your assistant reads less before it answers. <a href="/demo">More real answers</a>.</p>
  </section>

  <nav class="toc" aria-label="Areas">
    {areas.map((a) => <a href={`#${a.id}`}>{a.label}</a>)}
  </nav>

  {areas.map((a) => (
    <section class="block" aria-labelledby={a.id}>
      <h2 id={a.id}>{a.label}</h2>
      <p>{a.text}</p>
      <ul class="ask-list">{a.asks.map((q) => <li>{q}</li>)}</ul>
      <p class="meta-line"><a href={a.page.href}>{a.page.label}</a></p>
      <details class="dev-details">
        <summary>For developers: the tools behind this</summary>
        <ul>{a.tools.map((t) => <li><a href={`/tools#${t}`}><code>sfi.{t}</code></a></li>)}</ul>
      </details>
    </section>
  ))}

  <section class="block narrow" aria-labelledby="limits">
    <h2 id="limits">What it doesn’t do</h2>
    <ul class="ticks minus">
      <li>Change anything in the org. It only reads.</li>
      <li>Read records from the snapshot. That needs the optional live mode.</li>
      <li>See changes made after your last refresh.</li>
      <li>Follow Apex that builds queries or field names at run time.</li>
    </ul>
    <p class="meta-line">Every analysis, by name: <a href="/tools">Tools reference</a>. How far to trust an answer: <a href="/trust">Trust</a>.</p>
  </section>

  <CtaBlock />
</InfoPage>
