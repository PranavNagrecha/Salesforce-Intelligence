---
import DocPage from "../../layouts/DocPage.astro";
import GuideCards from "../../components/GuideCards.astro";
import site from "../../data/site.ts";
import { cards } from "../../lib/guides.ts";

const title = "Salesforce Admin & Architect Guides | sf-intelligence";
const description =
  "Plain-English Salesforce guides for admins, developers and architects: field changes, save order, deployments and errors. Plus sf-intelligence release notes.";

// Evergreen guides first (newest first), release notes and engineering posts after.
const byDate = (a: { date: string }, b: { date: string }) => b.date.localeCompare(a.date);
const guides = cards.filter((c) => c.kind === "guide").sort(byDate);
const releases = cards.filter((c) => c.kind === "release").sort(byDate);

const jsonld = [
  {
    "@type": "Blog",
    name: "sf-intelligence guides and release notes",
    description,
    isPartOf: { "@id": `${site.url}/#website` },
  },
  {
    "@type": "ItemList",
    itemListElement: [...guides, ...releases].map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.title,
      url: `${site.url}${p.href}`,
    })),
  },
];
---

<DocPage
  title={title}
  description={description}
  path="/blog"
  heading="Guides and release notes"
  intro="Plain-English guides to the questions Salesforce teams ask before they change something, and notes on what each sf-intelligence release changed."
  crumbs={[{ label: "Guides", href: "/blog" }]}
  breadcrumbs={[{ name: "Guides", path: "/blog" }]}
  jsonld={jsonld}
>
  <section>
    <div class="container">
      <h2 class="hub-h2" style="margin-top:0;">Guides</h2>
      <GuideCards cards={guides} dates />
      <p class="more">
        <a class="text-link" href="/how-to">All how-to guides <span aria-hidden="true">&rarr;</span></a>
        <span aria-hidden="true">&nbsp;·&nbsp;</span>
        <a class="text-link" href="/errors">Error messages explained <span aria-hidden="true">&rarr;</span></a>
      </p>

      <h2 class="hub-h2">Release notes</h2>
      <GuideCards cards={releases} dates />
    </div>
  </section>
</DocPage>
