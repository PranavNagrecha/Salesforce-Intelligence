const description =
  "sf-intelligence's deterministic, offline reasoning: joins your org vault against an org-independent Concept Model to turn metadata into cited structural claims - no LLM.";

const jsonld = [
  {
    "@type": "TechArticle",
    headline: "How sf-intelligence reasons about your Salesforce org",
    description:
      "The deterministic, offline reasoning model behind sfi.interpret: a two-graph join of the grounded org vault against an org-independent Concept Model (142 concepts / 193 rules) that returns cited, confidence-tiered structural claims - no LLM, no live org read.",
    author: { "@id": `${site.url}/#org` },
    publisher: { "@id": `${site.url}/#org` },
    datePublished: "2026-07-20",
    dateModified: "2026-07-20",
