---
import InfoPage from "../layouts/InfoPage.astro";
import AnswerCard from "../components/AnswerCard.astro";
import InstallTabs from "../components/InstallTabs.astro";
import TryDemo from "../components/TryDemo.astro";
import CtaBlock from "../components/CtaBlock.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { deleteField } from "../data/demo-answers.ts";
import siteData from "../data/site-data.json";
import site from "../data/site.ts";

const title = "Read-Only, Offline Salesforce MCP Server (Free)";
const description =
  "A free Salesforce MCP server that reads your org once and answers offline. It never writes. Works in Claude, Cursor, VS Code + Copilot and Codex.";
const heading = "A Salesforce MCP server that only reads";
const dateModified = "2026-10-10";
const canonical = `${site.url}/mcp`;
const ORG_ID = `${site.url}/#org`;
const SOFTWARE_ID = `${site.url}/#software`;

// @id scope is per document, so the SoftwareApplication is defined in full
// here too, with the same @id as the home page.
const jsonld = [
  {
    "@type": "TechArticle",
    "@id": `${canonical}#article`,
    headline: heading,
    description,
    author: { "@id": `${site.url}/#author` },
    publisher: { "@id": ORG_ID },
    dateModified,
    inLanguage: "en",
    mainEntityOfPage: { "@id": `${canonical}#webpage` },
    about: { "@id": SOFTWARE_ID },
  },
  {
    "@type": "SoftwareApplication",
    "@id": SOFTWARE_ID,
    name: "sf-intelligence",
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Salesforce MCP server",
    operatingSystem: "macOS, Linux, Windows (Node.js 20+)",
    softwareVersion: siteData.version,
    description:
      "A free, read-only Salesforce MCP server. It reads an org's metadata once and answers questions about dependencies, automation, access and deployment risk offline, naming every component it relies on.",
    license: `${site.url}/licensing`,
    url: `${site.url}/`,
    downloadUrl: site.npm,
    codeRepository: site.github,
    softwareHelp: `${site.url}/getting-started`,
    author: { "@id": ORG_ID },
    publisher: { "@id": ORG_ID },
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];

const faqs = [
  {
    q: "What is a Salesforce MCP server?",
    a: "MCP (Model Context Protocol) is the standard way AI assistants call outside tools. A Salesforce MCP server gives an assistant like Claude, Cursor or Copilot tools that know about your org, so it can look things up instead of guessing.",
  },
  {
    q: "Why read-only?",
    a: "So you can point it at production without a second thought. Its job is to explain the org: what depends on what, what runs on save, who can see what. Making changes stays with you and your release tools.",
  },
  {
    q: "Why offline?",
    a: "Answers come from a snapshot on your computer, so they’re fast, they work without a connection, and your org’s metadata isn’t sent to another service. You refresh the snapshot when the org changes.",
  },
  {
    q: "Can I run it alongside Salesforce’s own MCP servers?",
    a: "Yes. Theirs act on the org (records, deploys, tests); this one explains it. Many people register both. <a href=\"/compare/salesforce-dx-mcp\">How they differ</a>.",
  },
];
---

<InfoPage
  title={title}
  description={description}
  path="/mcp"
  heading={heading}
  lede="sf-intelligence reads your org’s metadata once and answers questions about it from your computer: what breaks if you change something, what runs on save, who can see what. It never writes to Salesforce."
  crumbs={[{ name: "MCP server", path: "/mcp" }]}
  jsonld={jsonld}
  dateModified={dateModified}
>
  <div class="answer-first narrow">
    <span class="label">Short answer</span>
    <p>sf-intelligence is a free, source-available MCP server for Salesforce. Most Salesforce MCP servers act on the org: they query records, deploy or run tests. This one only reads. It answers impact, automation and access questions from a local snapshot, and names every component an answer relies on.</p>
  </div>

  <section class="block" aria-labelledby="differs">
    <h2 id="differs">How it differs from other Salesforce MCP servers</h2>
    <table class="doc-table">
      <thead><tr><th scope="col"><span class="sr-only">Topic</span></th><th scope="col">sf-intelligence</th><th scope="col">Typical Salesforce MCP servers</th></tr></thead>
      <tbody>
        <tr><th scope="row">Job</th><td>Explain the org: dependencies, automation, access, deployment risk</td><td>Act on the org: records, queries, deploys, tests</td></tr>
        <tr><th scope="row">Writes to the org</th><td>Never. There is no write code</td><td>Often, where enabled</td></tr>
        <tr><th scope="row">Where answers come from</th><td>A snapshot on your computer. Works offline</td><td>Live calls to the org for each question</td></tr>
        <tr><th scope="row">Evidence</th><td>Names each component, how sure it is, and what it couldn’t check</td><td>Varies</td></tr>
        <tr><th scope="row">Price</th><td>Free</td><td>Free official tools, or paid services</td></tr>
      </tbody>
    </table>
    <p class="meta-line">Tool by tool: <a href="/compare">all comparisons</a>, starting with <a href="/compare/salesforce-dx-mcp">Salesforce’s own MCP servers</a>.</p>
  </section>

  <section class="block" aria-labelledby="try">
    <h2 id="try">Try it without a Salesforce org</h2>
    <p>One command adds a made-up demo org, Verdant Energy, to your assistant. No Salesforce login, no Salesforce CLI, nothing to connect.</p>
    <TryDemo id="mcp-try" />
    <p>Then ask: <strong>“Can I delete the Amount field on Invoice?”</strong> This is the real answer it gives:</p>
    <AnswerCard answer={deleteField} level={3} />
  </section>

  <section class="block" aria-labelledby="connect">
    <h2 id="connect">Connect your own org</h2>
    <p>First read the org once, read-only, from your Salesforce project folder: <code>npx -y sf-intelligence init --target-org my-org</code>, then <code>npx -y sf-intelligence refresh</code>. Then register the server with your assistant. Always give it the full path to the snapshot folder (<code>--vault</code>), because assistants start servers from a folder you don’t control.</p>
    <InstallTabs mode="org" idPrefix="mcp-host" />
    <p class="meta-line">Step-by-step: <a href="/getting-started">Getting started</a> · <a href="/use-cases/claude-salesforce-mcp">Ask Claude about your org</a></p>
  </section>

  <section class="block" aria-labelledby="ask">
    <h2 id="ask">Ask in plain words</h2>
    <p>You never need a tool name. Your assistant picks from the default set and can reach every other analysis when it needs to.</p>
    <ul class="ask-list">
      <li>What breaks if I delete the Status field on Project?</li>
      <li>Why can’t Installers see Invoices?</li>
      <li>What runs when a Project is saved?</li>
      <li>Is this deployment risky?</li>
    </ul>
    <p class="meta-line"><a href="/capabilities">Everything it can answer</a> · <a href="/tools">Tools reference</a></p>
  </section>

  <section class="block" aria-labelledby="safe">
    <h2 id="safe">Safe on production</h2>
    <ul class="ticks narrow">
      <li>Only commands you run, like <code>refresh</code>, contact Salesforce, and they only read</li>
      <li>Answers from the snapshot make no network calls</li>
      <li>The optional live mode is off until you turn it on for that org</li>
      <li>No telemetry by default</li>
    </ul>
    <p class="meta-line">The details: <a href="/trust">Trust</a> · <a href="/faq">FAQ</a></p>
  </section>

  <details class="dev-details">
    <summary>For developers: serving over HTTP</summary>
    <p>For CI or shared read-only access on your own machine, <code>sfi serve --http</code> serves the same tools over streamable HTTP with a bearer token. The live mode is always off over HTTP, so remote callers can’t reach your org. See <a href="/configuration">Configuration</a>.</p>
  </details>

  <section class="block" aria-labelledby="faq">
    <h2 id="faq">Questions</h2>
    <FaqBlock faqs={faqs} />
  </section>

  <CtaBlock />
</InfoPage>
