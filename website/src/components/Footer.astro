---
import site from "../data/site.ts";
import Wordmark from "./Wordmark.astro";

/* Column headings are <p>, not h4: a footer heading that skips levels breaks
   the page's heading order for screen readers. */
const columns = [
  {
    title: "Product",
    links: [
      { href: "/demo", label: "Demo" },
      { href: "/use-cases", label: "Use cases" },
      { href: "/capabilities", label: "Capabilities" },
      { href: "/tools", label: "Tools" },
      { href: "/compare", label: "Compare" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: "/getting-started", label: "Getting started" },
      { href: "/configuration", label: "Configuration" },
      { href: "/mcp", label: "Salesforce MCP server" },
      { href: "/agent-skills", label: "Agent skills" },
      { href: "/faq", label: "FAQ" },
      { href: "/glossary", label: "Glossary" },
    ],
  },
  {
    title: "Guides",
    links: [
      { href: "/how-to", label: "How-to guides" },
      { href: "/errors", label: "Error messages" },
      { href: "/how-to/find-what-is-updating-a-field", label: "What is updating this field?" },
      { href: "/how-to/pre-deployment-impact-review", label: "Is this deployment risky?" },
      { href: "/blog/salesforce-order-of-execution", label: "Order of execution" },
      { href: "/blog", label: "All guides and release notes" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: site.github, label: "GitHub", external: true },
      { href: site.npm, label: "npm", external: true },
      { href: "/trust", label: "Trust & security" },
      { href: "/ai-safety", label: "Is AI safe on my org?" },
      { href: "/licensing", label: "Licensing" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-about">
        <Wordmark />
        <p>A free, read-only Salesforce MCP server. Answers about your org, with every component cited.</p>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="foot-h">{col.title}</p>
          <ul class="foot-links">
            {col.links.map((l) => (
              <li><a href={l.href} rel={"external" in l && l.external ? "noopener" : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="foot-meta">
      <p>Not affiliated with Salesforce. Salesforce is a trademark of Salesforce, Inc.</p>
      <button class="theme-btn" type="button" id="theme-btn">Switch theme</button>
    </div>
  </div>
</footer>
