---
import Wordmark from "./Wordmark.astro";

interface Props {
  /** Current page path, used to mark the active nav item. */
  path?: string;
}
const { path = "" } = Astro.props;

const nav = [
  { href: "/use-cases", label: "Use cases" },
  { href: "/demo", label: "Demo" },
  { href: "/compare", label: "Compare" },
  { href: "/blog", label: "Guides" },
];
const isCurrent = (href: string): boolean => path === href || path.startsWith(href + "/");
---

<header class="site-header">
  <div class="wrap header-row">
    <Wordmark />
    <nav class="nav" id="site-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="btn btn-primary btn-sm" href="/getting-started">Install</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>
</header>
