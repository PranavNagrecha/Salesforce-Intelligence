---
import site from "../data/site.ts";

const nav = [
  { href: "/mcp", label: "mcp" },
  { href: "/capabilities", label: "capabilities" },
  { href: "/tools", label: "tools" },
  { href: "/use-cases", label: "use-cases" },
  { href: "/compare", label: "compare" },
  { href: "/blog", label: "blog" },
  { href: "/trust", label: "trust" },
  { href: "/getting-started", label: "get-started" },
  { href: "/faq", label: "faq" },
];
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="sf-intelligence home">
      <span class="mk">&gt;_</span>&nbsp;sf-intelligence
    </a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="btn btn-ghost" href={site.github} rel="noopener" aria-label="GitHub repository">GitHub</a>
      <a class="btn btn-ghost" href={site.npm} rel="noopener">npm</a>
      <a class="btn btn-solid" href="/getting-started">install</a>
      <button class="nav-toggle" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">menu</button>
    </div>
  </div>
  <div class="container">
    <div id="mobile-menu" class="mobile-menu">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/licensing">licensing</a></li>
        <li><a href={site.github} rel="noopener">GitHub</a></li>
      </ul>
      <a class="btn btn-solid" href="/getting-started" style="width:100%; justify-content:center;">install</a>
    </div>
  </div>
</header>
