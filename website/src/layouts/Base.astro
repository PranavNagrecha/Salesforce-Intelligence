---
import SeoHead from "../components/SeoHead.astro";
import type { Breadcrumb } from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/style.css";

interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumbs?: Breadcrumb[];
  jsonld?: Record<string, unknown>[];
  ogImage?: string;
  /** Set false for error pages that must not be indexed. */
  index?: boolean;
  /** og:type — "article" on blog posts. Forwarded to SeoHead. */
  ogType?: "website" | "article";
  /** ISO publish date (blog posts). */
  datePublished?: string;
  /** ISO date of the last meaningful content change. */
  dateModified?: string;
}
/* Extra <head> content (page-specific JSON-LD, preloads) goes in the "head" slot. */

const {
  title, description, path, breadcrumbs, jsonld, ogImage, index = true,
  ogType, datePublished, dateModified,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      path={path}
      breadcrumbs={breadcrumbs}
      jsonld={jsonld}
      ogImage={ogImage}
      index={index}
      ogType={ogType}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
