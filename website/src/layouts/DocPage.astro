---
import Base from "./Base.astro";
import type { Breadcrumb } from "../components/SeoHead.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  /** Big display heading (screen-type). Defaults to `heading` or `title`. */
  heading: string;
  /** Sub-hero intro paragraph. */
  intro?: string;
  breadcrumbs?: Breadcrumb[];
  jsonld?: Record<string, unknown>[];
  /** Visible breadcrumb trail links (label + href). Home is prepended. */
  crumbs?: { label: string; href: string }[];
  /** og:type — pass "article" on blog posts. Forwarded to SeoHead. */
  ogType?: "website" | "article";
  /** ISO publish date (blog posts). Feeds og/article + the WebPage node. */
  datePublished?: string;
  /** ISO date of the last meaningful content change. */
  dateModified?: string;
}

const {
  title, description, path, heading, intro, breadcrumbs, jsonld, crumbs,
  ogType, datePublished, dateModified,
} = Astro.props;

/* Older pages pass slug-style crumb labels ("getting-started"); show them as words. */
const humanize = (label: string): string =>
  /^[a-z0-9-]+$/.test(label) ? label.charAt(0).toUpperCase() + label.slice(1).replace(/-/g, " ") : label;
---

<Base
  title={title}
  description={description}
  path={path}
  breadcrumbs={breadcrumbs}
  jsonld={jsonld}
  ogType={ogType}
  datePublished={datePublished}
  dateModified={dateModified}
>
  <section class="page-hero">
    <div class="container">
      {crumbs && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c, i) => (
            <><span class="sep" aria-hidden="true">/</span><a href={c.href}>{breadcrumbs?.[i]?.name ?? humanize(c.label)}</a></>
          ))}
        </nav>
      )}
      <h1>{heading}</h1>
      {intro && <p class="lede" set:html={intro} />}
    </div>
  </section>
  <slot />
</Base>
